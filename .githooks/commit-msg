#!/bin/sh
# Checks a commit message against Conventional Commits, as set out in
# docs/agents/commits.md. Git runs it as the commit-msg hook once
# `git config core.hooksPath .githooks` is set; CI runs it on every commit in a PR.
#
# Usage: commit-msg <file containing the message>

set -eu

msg_file=${1:?usage: commit-msg <message-file>}

types='feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert'
pattern="^($types)(\([a-z0-9][a-z0-9-]*\))?!?: [^ ]"
max_header=72

# Git hands the hook the message before cleanup: drop comment lines, stop at the
# scissors line that `git commit -v` adds, and skip leading blank lines.
lines=$(awk '
	/^# -+ >8 -+$/ { exit }
	/^#/ { next }
	!started && /^[[:space:]]*$/ { next }
	{ started = 1; print }
' "$msg_file")

header=$(printf '%s\n' "$lines" | sed -n '1p')
second=$(printf '%s\n' "$lines" | sed -n '2p')

# An empty message: git aborts the commit itself.
[ -n "$header" ] || exit 0

# Messages git writes itself.
case $header in
	'Merge '* | 'Revert "'* | 'fixup! '* | 'squash! '* | 'amend! '*) exit 0 ;;
esac

# A warning only: the break may be approved, and CI runs this hook too.
case $header in
	*'!:'*) printf 'commit-msg: warning: "!" marks a break the listener notices across an upgrade and makes\nrelease-please propose a major version. Use it only with the owner'"'"'s approval;\nsee "Breaking changes" in docs/agents/commits.md.\n' >&2 ;;
esac

problems=''
if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
	problems="$problems
  - the header must be '<type>(<optional scope>)!: <description>'
    with type one of: $(printf '%s' "$types" | sed 's/|/, /g')"
fi
if [ "${#header}" -gt "$max_header" ]; then
	problems="$problems
  - the header is ${#header} characters; keep it to $max_header"
fi
case $header in
	*.) problems="$problems
  - drop the trailing period from the description" ;;
esac
if [ -n "$second" ]; then
	problems="$problems
  - leave a blank line between the header and the body"
fi

# The body and footers. Lines are counted in characters, not bytes, by
# dropping UTF-8 continuation bytes, which needs the C locale: gawk rejects
# a byte range in a UTF-8 one. A line with no spaces (a URL), a line
# in an indented or fenced block, and a Co-Authored-By: trailer may run past
# the wrap.
body_problems=$(printf '%s\n' "$lines" | LC_ALL=C awk -v max="$max_header" '
	function chars(s) { gsub(/[\200-\277]/, "", s); return length(s) }
	function is_footer(s) { return s ~ /^(BREAKING CHANGE|[A-Za-z][A-Za-z0-9-]*): [^ ]/ }
	function is_trailer(s) { return tolower(s) ~ /^co-authored-by: / }
	# Above the last paragraph, only these, so a body paragraph that opens
	# with "Note: ..." is not taken for a footer.
	function is_known_footer(s) {
		return tolower(s) ~ /^(refs|closes|fixes|breaking change|breaking-change|co-authored-by|signed-off-by): /
	}
	NR < 3 { next }
	/^[[:space:]]*```/ { fenced = !fenced; text[NR] = $0; last = NR; next }
	{
		text[NR] = $0
		if ($0 ~ /[^[:space:]]/) last = NR
		if (!fenced && $0 !~ /^(    |\t)/ && $0 ~ / / && !is_trailer($0) && chars($0) > max)
			printf "\n  - body line %d is %d characters; wrap at %d", NR, chars($0), max
	}
	END {
		# The paragraphs of the trailing footer block, from the last up.
		end = last
		while (end >= 3) {
			start = end
			while (start > 3 && text[start - 1] ~ /[^[:space:]]/) start--
			if (!(end == last ? is_footer(text[start]) : is_known_footer(text[start]))) break
			if (end != last) {
				printf "\n  - keep the footers in one block, with no blank line between them"
				break
			}
			trailer_seen = 0
			for (i = start; i <= end; i++) {
				if (is_trailer(text[i])) trailer_seen = 1
				else if (trailer_seen && is_footer(text[i])) {
					printf "\n  - put the Co-Authored-By: footers last"
					break
				}
			}
			end = start - 1
			while (end >= 3 && text[end] !~ /[^[:space:]]/) end--
		}
	}
')
problems="$problems$body_problems"

[ -z "$problems" ] && exit 0

{
	printf 'commit-msg: this message does not follow Conventional Commits:\n\n'
	printf '  %s\n' "$header"
	printf '%s\n\n' "$problems"
	printf 'Example: fix(macos): let a Device settle before opening its control link\n'
	printf 'See docs/agents/commits.md.\n'
} >&2
exit 1
