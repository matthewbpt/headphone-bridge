<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nearby devices: to see Connected Devices and open their control links. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application>
        <!-- The "Noise Control" home screen widget. -->
        <receiver
            android:name="dev.matthewbpt.headphonebridge.bluetooth.ModeWidget"
            android:exported="true"
            android:label="@string/hb_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mode_widget_info" />
        </receiver>

        <!-- The "Noise Control" Quick Settings tile. -->
        <service
            android:name="dev.matthewbpt.headphonebridge.bluetooth.ModeTile"
            android:exported="true"
            android:icon="@drawable/ic_noise_control"
            android:label="@string/hb_widget_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Long-pressing the tile opens the app. -->
        <activity
            android:name="dev.matthewbpt.headphonebridge.bluetooth.OpenAppActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Lends the frame log to the app picked in the share sheet. -->
        <provider
            android:name="dev.matthewbpt.headphonebridge.bluetooth.SharedFileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true">
            <!-- FileProvider.getUriForFile reads the paths from here. -->
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>
    </application>
</manifest>
