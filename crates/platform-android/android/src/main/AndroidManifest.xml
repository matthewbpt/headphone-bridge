<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nearby devices: to see Connected Devices and open their control links. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application>
        <!-- The "Noise Control" home screen widget. -->
        <receiver
            android:name="dev.matthewbpt.headphonebridge.bluetooth.ModeWidget"
            android:exported="true"
            android:label="@string/hb_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mode_widget_info" />
        </receiver>

        <!-- Lends the frame log to the app picked in the share sheet. -->
        <provider
            android:name="dev.matthewbpt.headphonebridge.bluetooth.SharedFileProvider"
            android:authorities="${applicationId}.shared"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
