<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A Noise Control Mode on the widget: a circle on the track, its label below. -->
    <style name="HbModeSlot">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HbModeCircleBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
    </style>

    <!-- Half the track: the slot's own share of the line between circles' centres. -->
    <style name="HbModeTrackRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">5dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="HbModeTrack">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@color/hb_surface_variant</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="HbModeCircle">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/mode_unselected</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/hb_text</item>
    </style>

    <style name="HbModeLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/hb_text</item>
    </style>
</resources>
